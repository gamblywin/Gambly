# BetSocial v0.10 — Supabase-ready
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# SUPABASE / POSTGRES
# Use a connection string from Supabase Project Settings > Database.
# Prefer the Transaction Pooler connection string for serverless/deployments.
DATABASE_URL=
DATABASE_SSL=true

# Optional Supabase identifiers (for future client-side features)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Password reset email
RESEND_API_KEY=
EMAIL_FROM=BetSocial <onboarding@resend.dev>

# Sports provider — Sportmonks (free plan)
# Crie sua conta e copie o token em: https://my.sportmonks.com/
SPORTMONKS_API_TOKEN=
SPORTMONKS_LIVESCORE_URL=https://api.sportmonks.com/v3/football/livescores/inplay

# Provider genérico legado (opcional)
SPORTS_API_URL=
SPORTS_API_KEY=
