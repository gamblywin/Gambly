{
  "name": "gambly",
  "version": "3.0.0",
  "private": true,
  "description": "GAMBLY — rede social esportiva com palpites, bilhetes, mercados de jogador, liquidação e dados esportivos",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "node api/server.js",
    "build": "next build",
    "start": "npm run build && concurrently -k \"node api/server.js\" \"next start -p 3000\"",
    "start:web": "next start -p ${PORT:-3000}",
    "api": "node api/server.js",
    "doctor": "node scripts/doctor.mjs",
    "preflight": "node scripts/preflight.mjs",
    "start:api": "node api/server.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "db:check": "node scripts/db-check.mjs",
    "predeploy": "npm run mvp:check && npm run build",
    "mvp:check": "npm run doctor && npm run typecheck && npm run preflight",
    "test:settlement": "node --test lib/settlement.test.mjs",
    "qa": "npm run typecheck && npm run test:settlement && npm run preflight"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "dotenv": "^17.4.2",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.2"
  }
}
